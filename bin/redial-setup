#!/usr/bin/env bash
# redial-setup -- checks/repairs the machine-level setup redial-hypr
# needs, on a new machine or when pairing a new physical dial. Idempotent and
# safe to re-run: every change is behind its own y/N prompt, nothing silent.
#
# This exists because every one of the checks below has independently caused a
# silent, hard-to-diagnose failure on this project before. Run with no arguments
# for a read-only report.
set -uo pipefail

# Matches redial-hypr's own find_node(): a loose case-insensitive
# substring check against the hidraw uevent, not an exact VID:PID parse --
# the BLE uhid HID_ID field is zero-padded ("0005:0000045E:0000091B") in a
# way that varies, so matching a literal padded/unpadded string is fragile.
HID_ID_SUBSTRING="091B"
DEVICE_NAME="Surface Dial System Multi Axis"
UDEV_RULE_PATH="/etc/udev/rules.d/70-redial.rules"
DAEMON_PATH="$HOME/.local/bin/redial-hypr"
AUTOSTART_PATH="$HOME/.config/hypr/autostart.lua"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/redial"

pass=0
fail=0

ok()   { printf '  [OK]   %s\n' "$1"; pass=$((pass + 1)); }
bad()  { printf '  [FAIL] %s\n' "$1"; fail=$((fail + 1)); }
warn() { printf '  [WARN] %s\n' "$1"; }

confirm() {
    read -rp "  $1 [y/N] " ans
    [[ "$ans" =~ ^[Yy] ]]
}

echo "== re:dial setup / doctor =="
echo

echo "-- Permissions --"

if id -nG "$USER" | tr ' ' '\n' | grep -qx input; then
    ok "user '$USER' is in the 'input' group"
else
    bad "user '$USER' is not in the 'input' group -- haptics (hidraw) and scroll (uinput) will fail"
    if confirm "Add $USER to the 'input' group now (needs sudo)?"; then
        sudo usermod -aG input "$USER" \
            && warn "added -- takes effect only after you log out/in or reboot; the current session keeps its old group list until then"
    fi
fi

if [[ -f "$UDEV_RULE_PATH" ]] && grep -q "045E:091B" "$UDEV_RULE_PATH"; then
    ok "udev rule present ($UDEV_RULE_PATH)"
else
    bad "udev rule missing or doesn't match ($UDEV_RULE_PATH)"
    if confirm "Install it now (needs sudo)?"; then
        if sudo tee "$UDEV_RULE_PATH" >/dev/null <<'EOF'
# Surface Dial (045e:091b)
#
# The dial arrives over Bluetooth LE, so it is a virtual `uhid` device with no
# ATTRS{idVendor}; a conventional USB-style rule will NOT match it. The
# VID:PID lives in the parent's kernel name instead: 0005:045E:091B.*
#
# Write access is needed to send haptic output reports -- the dial has no
# mechanical detents, so the clicks are a motor driven from userspace by
# redial-hypr.
KERNEL=="hidraw*", KERNELS=="0005:045E:091B.*", MODE="0660", GROUP="input"

# Virtual pointer/keyboard creation, for true wheel events (scroll that
# follows the cursor and reaches terminal scrollback, unlike arrow keys).
KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"
EOF
        then
            sudo udevadm control --reload-rules && sudo udevadm trigger
            ok "udev rule installed and reloaded"
        else
            bad "failed to write udev rule"
        fi
    fi
fi

echo
echo "-- Bluetooth pairing --"

if command -v bluetoothctl >/dev/null 2>&1; then
    if bluetoothctl devices 2>/dev/null | grep -qi "surface dial"; then
        ok "a Surface Dial is paired"
    else
        bad "no paired Surface Dial found"
        cat <<'EOF'

    To pair a new dial:
      1. Hold the dial's top button for ~5 seconds until it enters pairing
         mode (the LED starts flashing).
      2. Run:  bluetoothctl
      3.       scan on
      4. Wait for a line naming "Surface Dial", then:  scan off
      5.       pair   <the address from step 4>
      6.       trust  <same address>
      7.       connect <same address>
      8.       exit

EOF
    fi
else
    warn "bluetoothctl not found -- can't check pairing automatically"
fi

echo
echo "-- Daemon + Omarchy integration --"

if [[ -x "$DAEMON_PATH" ]]; then
    ok "daemon present at $DAEMON_PATH"
else
    bad "daemon not found at $DAEMON_PATH -- redial-setup only checks for it, it doesn't install it"
fi

if [[ -f "$AUTOSTART_PATH" ]] && grep -q 'launch_on_start("redial-hypr")' "$AUTOSTART_PATH"; then
    ok "Hyprland autostart entry present ($AUTOSTART_PATH)"
else
    warn "no autostart entry found -- add this line to $AUTOSTART_PATH:"
    warn '  o.launch_on_start("redial-hypr")'
fi

if [[ -f "$PLUGIN_DIR/manifest.json" ]]; then
    ok "redial plugin files present ($PLUGIN_DIR)"
    if command -v omarchy-shell >/dev/null 2>&1; then
        # No -q here on purpose: -q swallows the reply along with errors, and
        # the reply is the thing being checked.
        state=$(omarchy-shell dialmenu ping 2>/dev/null)
        if [[ "$state" == "ok" ]]; then
            ok "plugin is enabled and responding to IPC"
        else
            warn "plugin not responding -- run: omarchy-shell shell setPluginEnabled redial true"
        fi
    fi
else
    bad "plugin files not found at $PLUGIN_DIR"
fi

echo
echo "-- Live hardware --"

hidraw_hit=""
for uevent in /sys/class/hidraw/*/device/uevent; do
    [[ -f "$uevent" ]] || continue
    if grep -qi "$HID_ID_SUBSTRING" "$uevent" 2>/dev/null; then
        hidraw_hit="$(dirname "$(dirname "$uevent")")"
        break
    fi
done
if [[ -n "$hidraw_hit" ]]; then
    ok "dial hidraw node found ($hidraw_hit)"
else
    warn "no dial hidraw node found right now -- is it paired and connected?"
fi

if grep -q "Name=\"$DEVICE_NAME\"" /proc/bus/input/devices 2>/dev/null; then
    ok "dial event device found in /proc/bus/input/devices"
else
    warn "dial event device not found -- is it connected?"
fi

if pgrep -f "redial-hypr" >/dev/null 2>&1; then
    ok "daemon process is running"
else
    warn "daemon process not running"
fi

DAEMON_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/redial/daemon.log"
if [[ -f "$DAEMON_LOG" ]]; then
    ok "daemon log: $DAEMON_LOG (last line: $(tail -n 1 "$DAEMON_LOG" | cut -c1-70))"
else
    warn "no daemon log yet ($DAEMON_LOG) -- it appears once the daemon (re)starts on this version"
fi

echo
echo "== $pass ok, $fail failed =="
[[ "$fail" -eq 0 ]]
