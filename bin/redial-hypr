#!/usr/bin/env python3
"""redial-hypr -- start the re:dial daemon.

The daemon is the `redial` package: next to this file in a checkout, or in
${XDG_DATA_HOME:-~/.local/share}/redial/lib once installed. This launcher keeps the command line
`python3 ~/.local/bin/redial-hypr` that autostart, the systemd unit and every pgrep pattern use.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
for _root in (os.path.join(_here, ".."), os.path.join(_data, "redial", "lib")):
    if os.path.isfile(os.path.join(_root, "redial", "__init__.py")):
        sys.path.insert(0, os.path.abspath(_root))
        break

from redial.cli import main  # noqa: E402  (the path above must come first)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
