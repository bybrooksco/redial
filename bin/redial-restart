#!/usr/bin/env bash
# redial-restart -- restart the re:dial daemon.
#
# Stops a running redial-hypr (if any) and starts it again the way Omarchy does at
# login, through Hyprland, so it gets the session's real environment. The settings window's
# "Restart dial service" button runs this. The dial is unresponsive for a second or two.
set -u

RE='^python3 .*redial-hypr'
DAEMON="$HOME/.local/bin/redial-hypr"

if [[ ! -x "$DAEMON" ]]; then
    echo "redial-restart: $DAEMON not found; run install.sh first" >&2
    exit 1
fi

if pgrep -f "$RE" >/dev/null; then
    pkill -TERM -f "$RE"
    for _ in $(seq 1 15); do
        pgrep -f "$RE" >/dev/null || break
        sleep 0.2
    done
fi

if command -v hyprctl >/dev/null; then
    hyprctl dispatch "hl.dsp.exec_cmd(\"uwsm-app -- $DAEMON\")" >/dev/null
elif command -v redial-bar >/dev/null; then
    redial-bar restart
else
    echo "redial-restart: neither hyprctl nor redial-bar found" >&2
    exit 1
fi
echo "redial-restart: daemon restart requested"
